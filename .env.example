# Supabase — projeto SIC-HF (sa-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://fcfsnqqaphtamhrpuyoh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qxiG66XwJoQw07Khlust7w_RA-I7DXw
# pegar no painel: Settings > API > service_role. NUNCA commitar, nunca expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# IA — OpenRouter é o provedor padrão (rota pinada só na Anthropic:
# provider.order=["anthropic"], allow_fallbacks:false — mesma cadeia de
# subprocessador de hoje, sem risco de roteamento silencioso a Bedrock/
# Vertex/Azure). Pegar em openrouter.ai/keys.
OPENROUTER_API_KEY=
IA_PROVEDOR=openrouter
# Override de incidente/rollback rápido: se presente, vence o
# `prompts_versoes.modelo_padrao` do banco (não usar em operação normal).
# IA_MODELO_PADRAO=

# Claude API — fallback/reversão sem deploy: IA_PROVEDOR=anthropic chama a
# Anthropic direto pelo SDK, sem passar pelo OpenRouter.
ANTHROPIC_API_KEY=

# Hotmart — sem este secret o webhook RECUSA (fail-closed), nunca aceita.
HOTMART_WEBHOOK_SECRET=

# E-mail transacional
RESEND_API_KEY=
EMAIL_FROM=

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=https://escritorio.grupoparticipa.app.br

# Cron da régua (/api/cron/regua) e diagnóstico (/api/diagnostico) — fail-CLOSED:
# sem este segredo, o cron recusa (nunca dispara mensagem sem autenticação) e o
# diagnóstico responde 404 (não 401 — não revela nem que a rota existe). Valor já
# gerado pelo João para uso nesta noite — rotacionar antes de qualquer uso além
# do ambiente local/de teste, já que este arquivo é versionado no git.
CRON_SECRET=

# Fase 2 — Link Público (docs/ARQUITETURA-FASE-2.md §2). O token de 256 bits nunca
# chega ao banco: só o hash sha256(token || pepper) é gravado/consultado. Sem este
# pepper, /api/publico/* e a emissão de link (/api/jornadas/[id]/links) respondem
# 503 — nunca geram ou validam link com pepper vazio/hardcoded. Valor já gerado
# pelo João para uso nesta noite — mesma ressalva de rotação do CRON_SECRET acima.
LINK_PUBLICO_PEPPER=

# Fase 2 — Modo demonstração da IA (docs/ARQUITETURA-FASE-2.md §3). Só entra em
# jogo quando ANTHROPIC_API_KEY está AUSENTE: chave presente sempre vence, mesmo
# com a flag ligada (nunca demo silencioso com chave configurada). Com a chave
# ausente e a flag em false/ausente, o comportamento de hoje é preservado: 503
# honesto. Ligar só para destravar a vitrine com exemplo fixo, marcado e sem custo.
IA_MODO_DEMONSTRACAO=false

# Fase 2 — Módulo 4 / Base de Conhecimento (BLOQUEIO B13). Trava de LGPD: nenhuma
# transcrição de Sessão de Viabilidade (dado de cliente real, sem consentimento de
# tratamento por IA registrado) sai para a Anthropic enquanto esta flag for false.
# Ingestão, pareamento e busca funcionam sem ela — só o passe de IA fica bloqueado.
CONHECIMENTO_ANALISE_IA=false

# Teto de espera por uma geracao de IA, em milissegundos. Ausente = 300000 (5 min).
# Era 120s e se provou apertado: um briefing em modo reduzido levou 100,8s em
# producao. Briefing com transcricao passa disso. Vale para OpenRouter e para o
# caminho de rollback da Anthropic.
IA_TIMEOUT_MS=

# Sobrescreve o modelo de TODA execução de IA, ignorando `prompts_versoes.modelo_padrao`.
# Vazia = cada prompt usa o modelo dele (é o normal). Só preencha para forçar um
# modelo em toda a casa — ex.: testar um modelo novo sem mexer no banco.
# No caminho OpenRouter o id precisa do prefixo do provedor: `anthropic/claude-sonnet-5`.
IA_MODELO_PADRAO=

# Contato exibido nas telas públicas (link do cliente). Vazio = a tela omite o
# canal em vez de mostrar um contato errado.
NEXT_PUBLIC_CONTATO_EMAIL=
NEXT_PUBLIC_CONTATO_WHATSAPP=

# Só para `scripts/importar-transcricoes.ts` (Módulo 4). As 70 transcrições NÃO
# estão no repositório — é sigilo profissional. O script entra pelo login de um
# usuário `admin` de verdade porque a ingestão passa pela RLS como qualquer
# pessoa, não por service_role. Ver brain/06 - Materiais/Transcricoes/LEIA-ME.md.
# Nunca commite valor aqui.
INGESTAO_EMAIL=
INGESTAO_SENHA=
