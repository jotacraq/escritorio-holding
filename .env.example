# =============================================================================
# SIC-HF — variáveis de ambiente (modelo)
#
# Copie para `.env.local` (desenvolvimento) ou cole no hPanel da Hostinger
# (Node.js app → Environment variables) em produção. **Nunca comite valor real.**
#
# Cada bloco diz o que acontece quando a variável FALTA. Esta é a regra da casa:
# ausência de segredo NUNCA abre o portão (fail-CLOSED) e NUNCA vira dado
# inventado na tela — vira 503, stub rotulado ou tarefa para a equipe.
#
# O estado ao vivo de tudo isto está em **Admin → Integrações** (mostra só o
# NOME da variável que falta, nunca o valor).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase — projeto SIC-HF (fcfsnqqaphtamhrpuyoh, sa-east-1)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://fcfsnqqaphtamhrpuyoh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qxiG66XwJoQw07Khlust7w_RA-I7DXw

# Settings → API → service_role. NUNCA no client, nunca no git.
# Sem ela: as telas públicas `/p/*` caem para o fallback reduzido, a ligação por
# IA responde 503 e Admin → Integrações não consegue ler o estado real.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 2. Aplicação
# -----------------------------------------------------------------------------
# URL pública. Entra nos links `/p/*`. O endereço de retorno do n8n NÃO sai
# daqui desde 06/09/2026: é a Variable `SICHF_CALLBACK_URL` no próprio n8n
# (ver segurança mais abaixo). Errada aqui = link que o cliente abre e não funciona.
NEXT_PUBLIC_APP_URL=https://escritorio.grupoparticipa.app.br

# Contato mostrado nas telas públicas. Vazio = a tela OMITE o canal, em vez de
# mostrar um contato errado.
NEXT_PUBLIC_CONTATO_EMAIL=
NEXT_PUBLIC_CONTATO_WHATSAPP=

# -----------------------------------------------------------------------------
# 3. Segredos internos (fail-CLOSED)
# -----------------------------------------------------------------------------
# Cron da régua (`POST /api/cron/regua`, a cada 5 min no hPanel) e diagnóstico
# (`/api/diagnostico`). Sem ele: o cron responde 503 (nunca dispara mensagem sem
# autenticação) e o diagnóstico responde 404 — não revela nem que existe.
# O cron do hPanel manda este valor no header `x-cron-secret`.
CRON_SECRET=

# Pepper dos links públicos. O token de 256 bits nunca chega ao banco: só
# `sha256(token || pepper)`. Sem ele, emitir e validar link responde 503.
# TROCAR ESTE VALOR INVALIDA TODOS OS LINKS JÁ ENVIADOS AOS CLIENTES.
LINK_PUBLICO_PEPPER=

# -----------------------------------------------------------------------------
# 4. Ligação por IA (Vapi via n8n) — docs/integracoes/n8n-ligacao-ia.md
#    Faltando QUALQUER uma das três: a ligação não acontece e vira tarefa
#    rotulada para a equipe ligar (nunca falha em silêncio).
# -----------------------------------------------------------------------------
# Webhook LANCADOR no n8n (workflow zh5tjDcSoHaPaRRL).
N8N_WEBHOOK_LIGACAO_URL=https://infra-csm-n8n.nfpbgs.easypanel.host/webhook/sichf-ligacao-lancador

# Segredo compartilhado com o n8n: assina o POST SIC-HF → n8n E o retorno
# n8n → SIC-HF. Sem ele o webhook de retorno responde 503 (fail-closed).
# O MESMO valor tem de existir no n8n em Settings → Variables.
LIGACAO_IA_WEBHOOK_SECRET=

# ID do assistente de voz na Vapi ("SIC-HF · Ana · agendamento da SV").
VAPI_ASSISTENTE_ID=

# NÃO existem aqui, mas existem no n8n (Settings → Variables) — desde 06/09/2026:
#   VAPI_SERVER_SECRET  — o mesmo valor do Server Secret do assistant na Vapi.
#                         O nó do webhook confere `x-vapi-secret` com ele; sem
#                         isso qualquer um forjava uma "mensagem da Vapi" e o
#                         n8n a assinava com o segredo acima.
#   SICHF_CALLBACK_URL  — <APP_URL>/api/webhooks/n8n/ligacao. É o ÚNICO destino
#                         para onde o n8n devolve resultado (antes o endereço
#                         vinha dentro da mensagem recebida — SSRF).
# O servidor SIC-HF não lê nenhuma das duas. Ver docs/integracoes/n8n-ligacao-ia.md §8.

# -----------------------------------------------------------------------------
# 5. Sala de reunião (n8n) — só quando `sala.provedor = n8n`
#    Faltando: o link da sala é colado à mão na Ficha → Sessão.
# -----------------------------------------------------------------------------
N8N_WEBHOOK_SALA_URL=
INTEGRACOES_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 6. E-mail transacional (Resend)
#    Faltando: as mensagens ficam na fila e aparecem como "falhou" com o motivo.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: "Escritório <contato@dominio.com.br>".
EMAIL_FROM=

# -----------------------------------------------------------------------------
# 7. WhatsApp (Chatwoot) — só quando `regua.canal_whatsapp = chatwoot`
#    Faltando: a fila de WhatsApp continua manual (copiar → wa.me → marcar).
# -----------------------------------------------------------------------------
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=
# Assina o webhook de mensagens recebidas. Sem ele o endpoint recusa.
CHATWOOT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 8. Pagamento (Hotmart)
#    Sem o secret o webhook RECUSA tudo (503) — é o comportamento certo, não um
#    erro. Os IDs de produto ficam em Admin → Produtos, não aqui.
# -----------------------------------------------------------------------------
HOTMART_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 9. IA (briefing, croqui, material)
# -----------------------------------------------------------------------------
# OpenRouter é o provedor padrão, com rota pinada só na Anthropic
# (provider.order=["anthropic"], allow_fallbacks:false) — mesma cadeia de
# subprocessador de hoje, sem roteamento silencioso a Bedrock/Vertex/Azure.
OPENROUTER_API_KEY=
IA_PROVEDOR=openrouter

# Fallback sem deploy: `IA_PROVEDOR=anthropic` chama a Anthropic direto pelo SDK.
ANTHROPIC_API_KEY=

# Sobrescreve o modelo de TODA execução, ignorando `prompts_versoes.modelo_padrao`.
# Vazio = cada prompt usa o modelo dele (é o normal). No caminho OpenRouter o id
# precisa do prefixo do provedor: `anthropic/claude-sonnet-5`.
IA_MODELO_PADRAO=

# Teto de espera por uma geração, em ms. Vazio = 300000 (5 min). Era 120s e se
# provou apertado: um briefing em modo reduzido levou 100,8s em produção.
IA_TIMEOUT_MS=

# Modo demonstração: só entra em jogo quando NÃO há chave de IA. Chave presente
# sempre vence (nunca demo silencioso com chave configurada). Sem chave e com a
# flag em false, o comportamento é 503 honesto.
IA_MODO_DEMONSTRACAO=false

# NÃO existe mais `CONHECIMENTO_ANALISE_IA` aqui: nenhum código lê essa variável
# (conferido em 06/09/2026 com `grep -rho "process.env.[A-Z_]*" src scripts`).
# A trava do BLOQUEIO B13 é a tabela `decisoes_juridicas` (0048), não uma env.
# Deixá-la neste arquivo daria a impressão de que basta pôr `true` no servidor.

# -----------------------------------------------------------------------------
# 10. Só para scripts locais (`scripts/*.ts`) — NUNCA em produção
# -----------------------------------------------------------------------------
# `scripts/importar-transcricoes.ts`: a ingestão entra pelo login de um usuário
# `admin` de verdade, porque passa pela RLS como qualquer pessoa. As 70
# transcrições NÃO estão no repositório (sigilo profissional).
INGESTAO_EMAIL=
INGESTAO_SENHA=

# `scripts/seed-exemplo-completo.ts --sql`: sessão interna quando não há
# service_role à mão.
SEED_EMAIL=
SEED_SENHA=

# `scripts/simular-webhook-ligacao.ts`: contra qual servidor bater.
# Vazio = http://localhost:3000.
BASE_URL=

# `scripts/gerar-docx-exemplo.ts`: interpretador Python usado na conversão.
PYTHON_BIN=
